# Copie para .env.local e preencha. Nunca commite valores reais.

# IA (Claude). ANTHROPIC_BASE_URL só se usar proxy. Sem ANTHROPIC_MODEL usa claude-opus-5-5.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# Evidências científicas (Consensus). Sem chave, posts saem sem referências.
CONSENSUS_API_KEY=

# Tendências (opcional)
TRENDS_MCP_API_KEY=
TRENDS_MCP_URL=https://api.trendsmcp.ai/mcp

# Supabase (auth + banco). Sem estas duas, o app roda em modo local (só desenvolvimento).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Acesso privado ao estúdio. Lista separada por vírgulas; sem valor, ninguém entra em produção.
MEDCRIVO_ALLOWED_EMAILS=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Fotos nos slides (opcional). Sem isto, capa e CTA usam o fundo com as cores da marca.
# SLIDE_IMAGE_PROVIDER=pollinations
# POLLINATIONS_TOKEN=

# IA alternativa (Gemini). Sem chave da Anthropic, o estudio usa o Gemini; se o Claude falhar, tenta o Gemini.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
